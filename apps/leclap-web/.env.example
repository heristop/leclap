# Base URL of the compile server (exposes /compile, /templates, /health).
# Optional — the web app runs FFmpeg in-browser via WASM and only needs this
# for server-backed flows. Defaults to the local dev server when unset.
VITE_API_URL=http://localhost:8082

# Self-hosted Umami. Setting both switches analytics to Umami: the build swaps the Google Analytics
# snippet in index.html for a cookieless tag, and the consent banner is not rendered at all — the
# tracker sets no cookie and writes no identifier on the visitor's device, which is what the bar
# asks about (it still derives a pseudonymous visitor hash server-side).
# Takes precedence over the GA property in src/config/site.ts, which is then ignored.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
# Only when the collect API answers on another origin than the script.
VITE_UMAMI_HOST_URL=
