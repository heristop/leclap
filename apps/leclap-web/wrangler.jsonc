{
  // Workers static-assets config, kept for a `wrangler deploy` of this app on its own. It does NOT
  // describe how leclap.dev is served: production is Cloudflare **Pages** — the apex CNAMEs to
  // leclap.pages.dev and ships via `wrangler pages deploy apps/leclap-web/dist` (see README) — and
  // Pages ignores this `assets` block entirely. Nothing in package.json or CI reads this file.
  //
  // Production Pages routing is emitted by scripts/seo-prerender.ts:
  //   • _worker.js consolidates the production hostname and legacy routes, and serves noindex
  //     shells for utility/editor routes. Preview hostnames stay on the preview deployment.
  //   • 404.html disables the implicit SPA fallback, so unknown URLs return real 404 responses.
  //   • _headers remains the source of COOP/COEP for static assets (required by FFmpeg WASM).
  //   • Sibling <route>.html files keep canonical URLs free of trailing-slash redirects.
  "name": "leclap",
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
