{
  // Cloudflare Workers static-assets deploy for the web SPA. Set the Pages/Workers project's
  // "Root directory" to apps/leclap-web so `wrangler deploy` runs here (not the pnpm workspace root,
  // which trips wrangler's app auto-detection). `directory` is relative to this app → dist/.
  // public/_headers (COOP/COEP cross-origin isolation) is copied into dist and honored by Workers static
  // assets. SPA fallback is handled by `not_found_handling` below — no _redirects file (a `/* /index.html`
  // rewrite is rejected by Workers static-assets validation as a self-referential loop).
  //
  // Trailing slashes are NOT configured here. leclap.pages.dev is served by Cloudflare Pages, which
  // ignores this `assets` block entirely (it is Workers static-assets config) and whose slash handling
  // is fixed and non-configurable. scripts/seo-prerender.ts instead emits sibling `<route>.html` files
  // rather than `<route>/index.html`, which both Pages and Workers serve at the slash-less URL our
  // canonicals and sitemap declare. Setting `html_handling` here looks like it fixes that and does not.
  "name": "leclap",
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
