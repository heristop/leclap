{
  "global": {
    "variables": { "videoSample": "videos/earth.mp4" },
    "orientation": "landscape",
    "musicEnabled": false
  },
  "sections": [
    {
      "name": "cinemascope_clip",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2 },
      "grade": { "grain": 0.4 },
      "letterbox": { "aspect": 2.39, "color": "#000000" }
    },
    {
      "name": "narrow_aspect_clip",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2 },
      "letterbox": { "aspect": 1.5 }
    }
  ]
}
