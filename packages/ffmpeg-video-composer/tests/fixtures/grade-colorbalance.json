{
  "global": {
    "variables": { "videoSample": "videos/earth.mp4" },
    "orientation": "landscape",
    "musicEnabled": false,
    "transition": { "type": "fade", "duration": 0.5 }
  },
  "sections": [
    {
      "name": "graded",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2 },
      "grade": {
        "colorBalance": {
          "shadows": { "b": 0.08 },
          "midtones": { "r": 0.04 },
          "highlights": { "r": 0.06, "b": -0.05 }
        },
        "curvesPreset": "vintage"
      }
    }
  ]
}
