{
  "global": {
    "variables": {
      "video": "videos/earth.mp4",
      "colorsList": ["#FFFFFF"]
    },
    "orientation": "portrait",
    "musicEnabled": false,
    "transition": {
      "type": "fade",
      "duration": 0.5
    }
  },
  "sections": [
    {
      "name": "test_portrait",
      "type": "video",
      "options": {
        "videoUrl": "{{ video }}",
        "duration": 6,
        "forceOriginalAspectRatio": true,
        "musicVolume": 0.4
      },
      "inputs": [],
      "maps": [],
      "filters": [
        {
          "type": "boxblur",
          "value": "5"
        },
        {
          "type": "drawbox",
          "values": {
            "x": 0,
            "y": 0,
            "w": 720,
            "h": 1280,
            "c": "{{ color1 }}@0.15",
            "t": "fill"
          }
        },
        {
          "type": "fade",
          "values": {
            "t": "out",
            "d": "{{ transitionDuration }}",
            "st": "{{ transitionStartTime }}",
            "color": "#000000"
          }
        }
      ]
    }
  ]
}
