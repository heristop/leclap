{
  "global": {
    "variables": { "videoSample": "videos/earth.mp4" },
    "orientation": "landscape",
    "musicEnabled": true,
    "music": { "name": "point-being.mp3" },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.3,
      "normalize": "loudnorm",
      "ducking": { "threshold": 0.05, "ratio": 8, "attack": 20, "release": 400 }
    },
    "look": "teal-orange",
    "overlays": [
      {
        "text": { "en": "LeClap" },
        "position": "bottom-right",
        "effect": { "shadow": true, "outline": true }
      }
    ]
  },
  "sections": [
    {
      "name": "title",
      "type": "color_background",
      "options": { "backgroundColor": "#0d1b2a", "duration": 2 },
      "titleCard": {
        "kicker": { "en": "Kitchen Sink" },
        "headline": { "en": "Every New Effect" },
        "subtitle": { "en": "shadow · outline · LUT · key · grade · motion · slow-mo" },
        "accent": "#7C83FF",
        "reveal": "rise",
        "effect": { "shadow": true, "outline": { "width": 3 } }
      }
    },
    {
      "name": "graded",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2 },
      "look": "warm-film",
      "grade": { "colorBalance": { "shadows": { "b": 0.06 }, "highlights": { "r": 0.05 } }, "curvesPreset": "increase_contrast" },
      "lowerThird": {
        "title": { "en": "Warm Film LUT" },
        "subtitle": { "en": "lut3d-backed look" },
        "accent": "#FF6B6B",
        "badge": { "en": "01" },
        "effect": { "shadow": true, "outline": true }
      }
    },
    {
      "name": "keyed",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2 },
      "chromaKey": { "color": "#000000", "similarity": 0.18, "blend": 0.0, "background": "#10243f" },
      "caption": {
        "text": { "en": "Background removed" },
        "style": "bold",
        "effect": { "shadow": true }
      }
    },
    {
      "name": "geo",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2 },
      "motion": [
        { "type": "crop", "w": 960, "h": 540, "x": "(iw-ow)/2", "y": "(ih-oh)/2" },
        { "type": "rotate", "angle": 4 },
        { "type": "flip", "axis": "horizontal" }
      ],
      "caption": { "text": { "en": "crop · rotate · flip" }, "style": "bold", "effect": { "shadow": true } }
    },
    {
      "name": "slowmo",
      "type": "video",
      "options": { "videoUrl": "{{ videoSample }}", "duration": 2, "speed": 2, "muteSection": true },
      "maps": [{ "inputs": ["1:v"], "filters": [{ "type": "setpts", "value": "2*PTS" }], "outputs": ["final"] }],
      "caption": { "text": { "en": "slow-mo ×2" }, "style": "subtle", "position": "bottom", "effect": { "shadow": true } }
    },
    {
      "name": "motion",
      "type": "color_background",
      "options": { "backgroundColor": "#101418", "duration": 2 },
      "inputs": [
        {
          "name": "reticle",
          "url": "animations/pulse_ring.apng",
          "type": "animation",
          "options": { "fps": 25, "position": "500:290", "scale": "280:140", "persistent": true, "motion": "rise" }
        }
      ]
    }
  ]
}
