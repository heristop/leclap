{
  "meta": {
    "name": "App Tutorial",
    "description": "A clear square walkthrough: an eased topic card, your screen recording in its original colours and aspect ratio, a readable step caption, and a concise closing card."
  },
  "global": {
    "orientation": "square",
    "musicEnabled": true,
    "music": {
      "name": "the-builder.mp3"
    },
    "allowedMusic": ["the-builder", "lofi-hip-hop", "point-being", "upbeat-electronic", "lofi-chill"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.28,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your tutorial"
      },
      "description": {
        "en": "What you're teaching and the step shown over your screen recording"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_topic",
            "maxLength": 20,
            "label": {
              "en": "What you'll show"
            }
          },
          {
            "name": "form_1_step",
            "maxLength": 38,
            "label": {
              "en": "Step caption"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "titleCard": {
        "kicker": {
          "en": "HOW TO"
        },
        "headline": {
          "en": "{{ form_1_topic }}"
        },
        "subtitle": {
          "en": "One action. A better workflow."
        },
        "accent": "#2dd4bf",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 80
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 32,
          "color": "#d7e8e5"
        }
      },
      "options": {
        "backgroundColor": "#0f1419",
        "duration": 2.2,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#2dd4bf",
            "opacity": 0.16,
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#2dd4bf",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "lowerThird": {
        "title": {
          "en": "QUICK WALKTHROUGH"
        },
        "subtitle": {
          "en": "{{ form_1_step }}"
        },
        "badge": {
          "en": "STEP"
        },
        "accent": "#2dd4bf",
        "boxOpacity": 0.88,
        "reveal": {
          "type": "rise",
          "delay": 0.25,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        }
      },
      "title": {
        "en": "Record your screen"
      },
      "description": {
        "en": "Upload or record a screen walkthrough. The full frame is preserved and the step caption appears at the bottom."
      },
      "options": {
        "duration": 10,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "forceOriginalAspectRatio": true
      }
    },
    {
      "name": "outro",
      "type": "color_background",
      "titleCard": {
        "kicker": {
          "en": "NOW TRY IT"
        },
        "headline": {
          "en": "YOU'RE ALL SET"
        },
        "subtitle": {
          "en": "{{ form_1_topic }}"
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 80
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 32,
          "color": "#d7e8e5"
        },
        "accent": "#2dd4bf",
        "align": "center",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        },
        "fade": {
          "out": false
        }
      },
      "options": {
        "backgroundColor": "#0f1419",
        "duration": 2.4,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#2dd4bf",
            "opacity": 0.16,
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#2dd4bf",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      }
    }
  ]
}
