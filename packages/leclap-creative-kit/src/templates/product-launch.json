{
  "meta": {
    "name": "Product Launch",
    "description": "A polished vertical launch: eased title reveals, a clean product shot with your pitch and offer, and a clear closing card. Record or upload your product clip."
  },
  "global": {
    "orientation": "portrait",
    "variables": {
      "brand": "YOUR BRAND"
    },
    "musicEnabled": true,
    "music": {
      "name": "upbeat-electronic.mp3"
    },
    "allowedMusic": ["upbeat-electronic", "future-bass-energy", "the-builder", "indie-rock-dreamy", "arcadia"],
    "allowUploadMusic": true,
    "transition": {
      "type": "fade",
      "duration": 0.35
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    },
    "overlays": [
      {
        "text": {
          "en": "{{ form_1_name }}"
        },
        "position": "top-right",
        "color": "#ffffff",
        "size": 26,
        "effect": {
          "shadow": true
        },
        "reveal": {
          "type": "fade",
          "delay": 0.18,
          "duration": 0.65,
          "distance": 32,
          "easing": "ease-out"
        },
        "sections": ["video_1"]
      }
    ]
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your product"
      },
      "description": {
        "en": "The name and one-line pitch over your clip, with your offer on the closing card"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_name",
            "maxLength": 13,
            "label": {
              "en": "Product name"
            }
          },
          {
            "name": "form_1_tagline",
            "maxLength": 24,
            "label": {
              "en": "One-line pitch"
            }
          },
          {
            "name": "form_1_price",
            "maxLength": 12,
            "label": {
              "en": "Price or offer"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "transition": {
        "type": "smoothup",
        "duration": 0.35
      },
      "titleCard": {
        "kicker": {
          "en": "INTRODUCING"
        },
        "headline": {
          "en": "{{ form_1_name }}"
        },
        "subtitle": {
          "en": "{{ form_1_tagline }}"
        },
        "accent": "#a69bff",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 88
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 32,
          "color": "#d7d5e8"
        }
      },
      "options": {
        "backgroundColor": "#0b0e24",
        "duration": 2.4,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#25213f",
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#a69bff",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "vivid-pop",
      "inputs": [
        {
          "name": "reticle",
          "url": "/assets/animations/corner_brackets.apng",
          "type": "animation",
          "options": {
            "loop": true,
            "persistent": true,
            "position": "0:0",
            "scale": "720:1280",
            "opacity": 0.28
          }
        }
      ],
      "lowerThird": {
        "title": {
          "en": "{{ form_1_name }}"
        },
        "subtitle": {
          "en": "{{ form_1_tagline }}"
        },
        "accent": "#a69bff",
        "reveal": {
          "type": "rise",
          "delay": 0.35,
          "duration": 0.65,
          "distance": 32,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        },
        "boxOpacity": 0.78
      },
      "title": {
        "en": "Show your product"
      },
      "description": {
        "en": "Keep the product steady and centred — the name and pitch reveal along the bottom"
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2
      },
      "filters": [
        {
          "type": "vignette"
        }
      ]
    },
    {
      "name": "outro",
      "type": "color_background",
      "titleCard": {
        "kicker": {
          "en": "MAKE IT YOURS"
        },
        "headline": {
          "en": "{{ form_1_name }}"
        },
        "subtitle": {
          "en": "{{ form_1_price }}"
        },
        "accent": "#a69bff",
        "align": "center",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 88
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 32,
          "color": "#d7d5e8"
        },
        "fade": {
          "out": false
        },
        "effect": {
          "shadow": true
        }
      },
      "options": {
        "backgroundColor": "#0b0e24",
        "duration": 2.6,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#25213f",
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#a69bff",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      }
    }
  ]
}
