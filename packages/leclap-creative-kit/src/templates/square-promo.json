{
  "meta": {
    "name": "Square Promo",
    "description": "A bold editorial square campaign: contrasting panels, staggered lateral typography, a full-bleed product clip and a graphic closing invitation."
  },
  "global": {
    "orientation": "square",
    "variables": {
      "brand": "YOUR LOGO"
    },
    "musicEnabled": true,
    "music": {
      "name": "upbeat-electronic.mp3"
    },
    "allowedMusic": ["upbeat-electronic", "future-bass-energy", "party-dance", "lofi-hip-hop", "indie-rock-dreamy"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    },
    "overlays": [
      {
        "text": {
          "en": "{{ brand }}"
        },
        "position": "top-right",
        "color": "#ffffff",
        "size": 32,
        "effect": {
          "shadow": true
        },
        "reveal": {
          "type": "fade",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "sections": ["video_1"]
      }
    ]
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your promo"
      },
      "description": {
        "en": "Headline shown on your clip; supporting line on the opening card"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_headline",
            "maxLength": 20,
            "label": {
              "en": "Headline"
            }
          },
          {
            "name": "form_1_subtitle",
            "maxLength": 32,
            "label": {
              "en": "Subtitle"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#e6ff72",
        "duration": 1.9,
        "layers": [
          {
            "color": "#17211d",
            "x": 0,
            "y": 720,
            "w": "iw",
            "h": 360
          },
          {
            "color": "#17211d",
            "x": 64,
            "y": 160,
            "w": 952,
            "h": 4
          }
        ]
      },
      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ brand }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 30,
            "fontcolor": "#17211d",
            "x": 64,
            "y": 70
          },
          "reveal": {
            "type": "fade",
            "delay": 0,
            "duration": 0.18,
            "easing": "ease-out"
          },
          "exit": {
            "type": "fade",
            "after": 1.72,
            "duration": 0.14,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_headline }}"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 80,
            "fontcolor": "#17211d",
            "x": 64,
            "y": 340
          },
          "reveal": {
            "type": "slide-right",
            "delay": 0.04,
            "duration": 0.28,
            "easing": "ease-out",
            "distance": 80
          },
          "exit": {
            "type": "slide-left",
            "after": 1.65,
            "duration": 0.18,
            "easing": "ease-out",
            "distance": 52
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_subtitle }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 32,
            "fontcolor": "#e6ff72",
            "x": 64,
            "y": 770
          },
          "reveal": {
            "type": "slide-left",
            "delay": 0.12,
            "duration": 0.24,
            "easing": "ease-out",
            "distance": 44
          },
          "exit": {
            "type": "slide-right",
            "after": 1.69,
            "duration": 0.18,
            "easing": "ease-out",
            "distance": 32
          }
        }
      ]
    },
    {
      "name": "video_1",
      "type": "project_video",
      "title": {
        "en": "Record your clip"
      },
      "description": {
        "en": "Filmed square \u2014 captioned with your headline"
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2
      },
      "caption": {
        "text": {
          "en": "{{ form_1_headline }}"
        },
        "style": "bold",
        "position": "bottom",
        "align": "left",
        "font": "bebas",
        "fontsize": 72,
        "color": "#e6ff72",
        "box": true,
        "boxColor": "#17211d",
        "boxOpacity": 0.88,
        "reveal": {
          "type": "slide-right",
          "delay": 0.08,
          "duration": 0.26,
          "easing": "ease-out",
          "distance": 56
        },
        "effect": {
          "shadow": true
        }
      }
    },
    {
      "name": "outro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#17211d",
        "duration": 2,
        "layers": [
          {
            "color": "#e6ff72",
            "x": 0,
            "y": 0,
            "w": 40,
            "h": "ih"
          },
          {
            "color": "#e6ff72",
            "x": 64,
            "y": 810,
            "w": 952,
            "h": 3
          }
        ]
      },
      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "MAKE IT"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 152,
            "fontcolor": "#e6ff72",
            "x": "'64+(1-(1+2.2*pow((min(1,max(0,(t-0.04)/0.36)))-1,3)+1.2*pow((min(1,max(0,(t-0.04)/0.36)))-1,2)))*70'",
            "y": 230
          },
          "reveal": {
            "type": "fade",
            "delay": 0.04,
            "duration": 0.24,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "HAPPEN."
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 152,
            "fontcolor": "#e6ff72",
            "x": "'64+(1-(1+2.2*pow((min(1,max(0,(t-0.12)/0.36)))-1,3)+1.2*pow((min(1,max(0,(t-0.12)/0.36)))-1,2)))*-70'",
            "y": 510
          },
          "reveal": {
            "type": "fade",
            "delay": 0.12,
            "duration": 0.24,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ brand }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 36,
            "fontcolor": "#ffffff",
            "x": 64,
            "y": 880
          },
          "reveal": {
            "type": "rise",
            "delay": 0.26,
            "duration": 0.22,
            "easing": "ease-out",
            "distance": 24
          }
        }
      ]
    }
  ]
}
