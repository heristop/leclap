{
  "meta": {
    "name": "Square Promo",
    "description": "A focused square social ad: a quick headline reveal, your clip with a readable pitch, and a closing invitation. Customise the headline, supporting line and brand."
  },
  "global": {
    "orientation": "square",
    "variables": {
      "brand": "YOUR LOGO"
    },
    "musicEnabled": true,
    "music": {
      "name": "upbeat-electronic.mp3"
    },
    "allowedMusic": ["upbeat-electronic", "future-bass-energy", "party-dance", "lofi-hip-hop", "indie-rock-dreamy"],
    "allowUploadMusic": true,
    "transition": {
      "type": "fade",
      "duration": 0.25
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    },
    "overlays": [
      {
        "text": {
          "en": "{{ brand }}"
        },
        "position": "top-right",
        "color": "#ffffff",
        "size": 32,
        "effect": {
          "shadow": true
        },
        "reveal": {
          "type": "fade",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "sections": ["video_1"]
      }
    ]
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your promo"
      },
      "description": {
        "en": "Headline and subtitle shown over your clip"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_headline",
            "maxLength": 20,
            "label": {
              "en": "Headline"
            }
          },
          {
            "name": "form_1_subtitle",
            "maxLength": 32,
            "label": {
              "en": "Subtitle"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#10101b",
        "duration": 2,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#a69bff",
            "opacity": 0.16,
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#a69bff",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      },
      "titleCard": {
        "kicker": {
          "en": "{{ brand }}"
        },
        "headline": {
          "en": "{{ form_1_headline }}"
        },
        "subtitle": {
          "en": "{{ form_1_subtitle }}"
        },
        "kickerStyle": {
          "font": "oswald",
          "fontsize": 32
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 80
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 32,
          "color": "#d7d5e8"
        },
        "accent": "#a69bff",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        }
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "warm-film",
      "inputs": [
        {
          "name": "promo_glow",
          "url": "/assets/animations/glow_border.apng",
          "type": "animation",
          "options": {
            "loop": true,
            "persistent": true,
            "position": "0:0",
            "scale": "1080:1080",
            "opacity": 0.15
          }
        }
      ],
      "title": {
        "en": "Record your clip"
      },
      "description": {
        "en": "Filmed square — captioned with your headline"
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2
      },
      "filters": [
        {
          "type": "vignette"
        }
      ],
      "lowerThird": {
        "title": {
          "en": "{{ form_1_headline }}"
        },
        "subtitle": {
          "en": "{{ form_1_subtitle }}"
        },
        "accent": "#a69bff",
        "boxOpacity": 0.8,
        "reveal": {
          "type": "rise",
          "delay": 0.25,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        }
      }
    },
    {
      "name": "outro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#10101b",
        "duration": 2.4,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#a69bff",
            "opacity": 0.16,
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#a69bff",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      },
      "titleCard": {
        "kicker": {
          "en": "{{ brand }}"
        },
        "headline": {
          "en": "MAKE IT HAPPEN"
        },
        "subtitle": {
          "en": "{{ form_1_headline }}"
        },
        "kickerStyle": {
          "font": "oswald",
          "fontsize": 32
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 80
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 32,
          "color": "#d7d5e8"
        },
        "accent": "#a69bff",
        "align": "center",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "effect": {
          "shadow": true
        },
        "fade": {
          "out": false
        }
      }
    }
  ]
}
