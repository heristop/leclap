{
  "meta": {
    "name": "Story Reel",
    "description": "Three punchy vertical moments with eased, readable captions and scene markers. Clean cuts keep the rhythm moving; your last scene closes the story."
  },
  "global": {
    "orientation": "portrait",
    "musicEnabled": true,
    "music": {
      "name": "indie-rock-dreamy.mp3"
    },
    "allowedMusic": ["indie-rock-dreamy", "lofi-chill", "lofi-hip-hop", "cafe-jazz", "romantic-piano"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.25,
      "musicFade": 0.8,
      "normalize": "loudnorm",
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Caption each scene"
      },
      "description": {
        "en": ""
      },
      "options": {
        "fields": [
          {
            "name": "form_1_scene1",
            "maxLength": 24,
            "label": {
              "en": "Scene 1 caption"
            }
          },
          {
            "name": "form_1_scene2",
            "maxLength": 24,
            "label": {
              "en": "Scene 2 caption"
            }
          },
          {
            "name": "form_1_scene3",
            "maxLength": 24,
            "label": {
              "en": "Scene 3 caption"
            }
          }
        ]
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "look": "vivid-pop",
      "caption": {
        "text": {
          "en": "{{ form_1_scene1 }}"
        },
        "style": "bar",
        "position": "bottom",
        "align": "center",
        "effect": {
          "shadow": true
        },
        "font": "bebas",
        "fontsize": 44,
        "boxColor": "#0b0e24",
        "boxOpacity": 0.78,
        "reveal": {
          "type": "rise",
          "delay": 0.1,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        }
      },
      "title": {
        "en": "Scene 1"
      },
      "description": {
        "en": "Film your first moment — keep it short and punchy"
      },
      "options": {
        "duration": 4,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2
      },
      "filters": [
        {
          "type": "vignette"
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "1 / 3"
            },
            "fontcolor": "#ffffff",
            "fontsize": 36,
            "x": "w-text_w-44",
            "y": 80,
            "fontfile": "Oswald.ttf",
            "box": 1,
            "boxcolor": "#0b0e24@0.55",
            "boxborderw": 10
          },
          "reveal": {
            "type": "fade",
            "delay": 0.08,
            "duration": 0.5,
            "distance": 24,
            "easing": "ease-out"
          }
        }
      ]
    },
