{
  "meta": {
    "name": "Web App Promo",
    "description": "A landscape interface showcase with a split composition, fast staggered promise, screen capture with a readable feature caption and a wide call-to-action."
  },
  "global": {
    "orientation": "landscape",
    "musicEnabled": true,
    "music": {
      "name": "upbeat-electronic.mp3"
    },
    "allowedMusic": ["the-builder", "upbeat-electronic", "lofi-chill"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.22,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your app story"
      },
      "description": {
        "en": "The headline, feature and invitation shown in your promo"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_app",
            "maxLength": 20,
            "label": {
              "en": "App name"
            }
          },
          {
            "name": "form_1_promise",
            "maxLength": 26,
            "label": {
              "en": "One-line promise"
            }
          },
          {
            "name": "form_1_feature",
            "maxLength": 38,
            "label": {
              "en": "Feature to show"
            }
          },
          {
            "name": "form_1_cta",
            "maxLength": 24,
            "label": {
              "en": "Call to action"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#10141e",
        "duration": 1.9,
        "layers": [
          {
            "color": "#91a7ff",
            "x": 0,
            "y": 0,
            "w": 18,
            "h": "ih"
          },
          {
            "color": "#242e44",
            "x": 900,
            "y": 0,
            "w": 380,
            "h": "ih"
          }
        ]
      },
      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_app }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 30,
            "fontcolor": "#91a7ff",
            "x": 64,
            "y": 74
          },
          "reveal": {
            "type": "fade",
            "delay": 0,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_promise }}"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 72,
            "fontcolor": "#ffffff",
            "x": 64,
            "y": 260
          },
          "reveal": {
            "type": "slide-right",
            "delay": 0.08,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          },
          "exit": {
            "type": "slide-left",
            "after": 1.6,
            "duration": 0.2,
            "distance": 70
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_feature }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 28,
            "fontcolor": "#c9d3ea",
            "x": 64,
            "y": 405
          },
          "reveal": {
            "type": "slide-left",
            "delay": 0.22,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "01"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 112,
            "fontcolor": "#91a7ff",
            "x": 980,
            "y": 510
          },
          "reveal": {
            "type": "rise",
            "delay": 0.18,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          }
        }
      ]
    },
    {
      "name": "video_1",
      "type": "project_video",
      "title": {
        "en": "Show your app"
      },
      "description": {
        "en": "Upload a landscape screen recording or film a walkthrough. Keep the feature you want to show above the caption band."
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2,
        "forceOriginalAspectRatio": true
      },
      "caption": {
        "text": {
          "en": "{{ form_1_feature }}"
        },
        "style": "bar",
        "position": "bottom",
        "align": "left",
        "font": "oswald",
        "fontsize": 30,
        "boxColor": "#10141e",
        "boxOpacity": 0.94,
        "reveal": {
          "type": "slide-right",
          "delay": 0.2,
          "duration": 0.35,
          "distance": 75,
          "easing": "ease-out"
        }
      }
    },
    {
      "name": "outro",
      "type": "color_background",
      "options": {
        "backgroundColor": "#91a7ff",
        "duration": 2,
        "layers": [
          {
            "color": "#10141e",
            "x": 0,
            "y": 610,
            "w": "iw",
            "h": 110
          }
        ]
      },
      "filters": [
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_cta }}"
            },
            "fontfile": "BebasNeue.ttf",
            "fontsize": 80,
            "fontcolor": "#10141e",
            "x": 64,
            "y": 230
          },
          "reveal": {
            "type": "slide-right",
            "delay": 0.06,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_promise }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 32,
            "fontcolor": "#10141e",
            "x": 64,
            "y": 355
          },
          "reveal": {
            "type": "rise",
            "delay": 0.22,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          }
        },
        {
          "type": "drawtext",
          "values": {
            "text": {
              "en": "{{ form_1_app }}"
            },
            "fontfile": "Oswald.ttf",
            "fontsize": 30,
            "fontcolor": "#ffffff",
            "x": 64,
            "y": 650
          },
          "reveal": {
            "type": "slide-left",
            "delay": 0.35,
            "duration": 0.3,
            "distance": 90,
            "easing": "ease-out"
          }
        }
      ]
    }
  ]
}
