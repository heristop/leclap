{
  "meta": {
    "name": "Web App Promo",
    "description": "A landscape promo for your web app: an eased headline, an ungraded screen recording with a feature caption, and a closing call to action. Upload a screen capture or record a walkthrough."
  },
  "global": {
    "orientation": "landscape",
    "musicEnabled": true,
    "music": {
      "name": "upbeat-electronic.mp3"
    },
    "allowedMusic": ["the-builder", "upbeat-electronic", "lofi-chill"],
    "allowUploadMusic": true,
    "transition": {
      "type": "cut"
    },
    "audio": {
      "sourceVolume": 1,
      "musicVolume": 0.22,
      "musicFade": 0.8,
      "ducking": {
        "threshold": 0.05,
        "ratio": 8,
        "attack": 20,
        "release": 400
      }
    }
  },
  "sections": [
    {
      "name": "form_1",
      "type": "form",
      "title": {
        "en": "Your app story"
      },
      "description": {
        "en": "The headline, feature and invitation shown in your promo"
      },
      "options": {
        "fields": [
          {
            "name": "form_1_app",
            "maxLength": 20,
            "label": {
              "en": "App name"
            }
          },
          {
            "name": "form_1_promise",
            "maxLength": 26,
            "label": {
              "en": "One-line promise"
            }
          },
          {
            "name": "form_1_feature",
            "maxLength": 38,
            "label": {
              "en": "Feature to show"
            }
          },
          {
            "name": "form_1_cta",
            "maxLength": 24,
            "label": {
              "en": "Call to action"
            }
          }
        ]
      }
    },
    {
      "name": "intro",
      "type": "color_background",
      "titleCard": {
        "kicker": {
          "en": "MEET {{ form_1_app }}"
        },
        "headline": {
          "en": "{{ form_1_promise }}"
        },
        "subtitle": {
          "en": "A better way to work."
        },
        "accent": "#a69bff",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 80
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 24,
          "color": "#d7d5e8"
        },
        "effect": {
          "shadow": true
        }
      },
      "options": {
        "backgroundColor": "#10101b",
        "duration": 2.2,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#25213f",
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#a69bff",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      }
    },
    {
      "name": "video_1",
      "type": "project_video",
      "title": {
        "en": "Show your app"
      },
      "description": {
        "en": "Upload a landscape screen recording or film a walkthrough. Keep the feature you want to show above the caption band."
      },
      "lowerThird": {
        "title": {
          "en": "{{ form_1_feature }}"
        },
        "subtitle": {
          "en": "{{ form_1_app }}"
        },
        "badge": {
          "en": "IN ACTION"
        },
        "accent": "#a69bff",
        "boxOpacity": 0.88,
        "reveal": {
          "type": "rise",
          "delay": 0.3,
          "duration": 0.65,
          "distance": 32,
          "easing": "ease-out"
        }
      },
      "options": {
        "duration": 6,
        "forceAspectRatio": true,
        "countdown": true,
        "countdownDuration": 2
      }
    },
    {
      "name": "outro",
      "type": "color_background",
      "titleCard": {
        "kicker": {
          "en": "{{ form_1_app }}"
        },
        "headline": {
          "en": "{{ form_1_cta }}"
        },
        "subtitle": {
          "en": "{{ form_1_promise }}"
        },
        "accent": "#a69bff",
        "align": "center",
        "reveal": {
          "type": "rise",
          "delay": 0.08,
          "duration": 0.5,
          "distance": 24,
          "easing": "ease-out"
        },
        "headlineStyle": {
          "font": "bebas",
          "fontsize": 72
        },
        "subtitleStyle": {
          "font": "oswald",
          "fontsize": 24,
          "color": "#d7d5e8"
        },
        "fade": {
          "out": false
        },
        "effect": {
          "shadow": true
        }
      },
      "options": {
        "backgroundColor": "#10101b",
        "duration": 2.4,
        "layers": [
          {
            "color": "#191832",
            "x": 0,
            "y": 0,
            "w": "iw",
            "h": "ih*0.22"
          },
          {
            "color": "#25213f",
            "x": "iw*0.92",
            "y": 0,
            "w": "iw*0.08",
            "h": "ih"
          },
          {
            "color": "#a69bff",
            "opacity": 0.8,
            "x": "iw*0.92",
            "y": 0,
            "w": 3,
            "h": "ih"
          }
        ]
      }
    }
  ]
}
