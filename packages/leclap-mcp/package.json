{
  "name": "@leclap/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing ffmpeg-video-composer as agent-callable video composition tools",
  "author": "heristop",
  "license": "MIT",
  "type": "module",
  "bin": {
    "leclap-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:integration": "pnpm --filter ffmpeg-video-composer build && pnpm build && NODE_OPTIONS=\"--import tsx/esm\" cucumber-js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ffmpeg-video-composer": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@remotion/bundler": ">=4",
    "@remotion/renderer": ">=4"
  },
  "peerDependenciesMeta": {
    "@remotion/bundler": {
      "optional": true
    },
    "@remotion/renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@remotion/bundler": "^4.0.509",
    "@remotion/renderer": "^4.0.509",
    "@types/node": "^25.9.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
